DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
SUPABASE_JWKS_URL="http://localhost:54321/auth/v1/.well-known/jwks.json"
# Optional JWT claim checks (unset = skipped, current local-dev behavior). Set both once a real
# Supabase project exists (Plan 4) to enforce issuer/audience on every verified token.
# SUPABASE_JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"
# SUPABASE_JWT_AUDIENCE="authenticated"
RULES_BOUTIQUE_MAX_BRANCHES=3
RULES_STALE_DAYS=90
RULES_MOD_AUTO_HIDE_REPORTS=3
# Rate limit configuration (requests per time window).
RATE_LIMIT_READ_PER_MINUTE=100
RATE_LIMIT_REPORT_PER_DAY=10
# Number of trusted reverse-proxy hops in front of this process (Fastify's `trustProxy`). Controls
# whether `req.ip` (used by RateLimitGuard to key its bucket) trusts X-Forwarded-For, or uses the
# raw socket address. Local dev default is unset/0 (no proxy here -- trusting one would let a
# client forge its own X-Forwarded-For and pick any rate-limit bucket). Set to the real hop count
# (e.g. 1 for a single load balancer) once real infrastructure exists (Plan 4).
# TRUST_PROXY_HOPS=1
# Comma-separated list of origins allowed to call this API cross-origin (CORS).
# Local dev default covers the web/admin Next.js apps; Plan 4 (infra) sets the real
# production value(s) when those apps are deployed.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
