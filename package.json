{
  "name": "gurmego",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter=@gurmego/shared --filter=@gurmego/api-client --filter=@gurmego/api && turbo run test --filter=@gurmego/web && turbo run test --filter=@gurmego/admin && turbo run test --filter=@gurmego/mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "fast-uri@3": "^3.1.6",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18"
    }
  }
}
